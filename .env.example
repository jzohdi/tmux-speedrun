# Database connection
# For local development with docker-compose:
DATABASE_URL="postgresql://tmux:tmux@localhost:5432/tmux_speedrun"

# Session secret for signing cookies
# Generate with: openssl rand -base64 32
SESSION_SECRET="your-secret-key-here-change-in-production"

# Application origin (used for CORS and CSRF protection)
# Development:
ORIGIN="http://localhost:5173"
# Production:
# ORIGIN="https://your-domain.com"

# GitHub OAuth (optional — enables verified sign-in on the leaderboard)
# Callback URL to register in the GitHub OAuth App: ${ORIGIN}/api/auth/github/callback
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
